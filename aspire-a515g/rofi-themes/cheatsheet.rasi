/* Keybinding cheatsheet — wide, single column, monospace, no icons. */
@import "catppuccin"

window {
    width:            1100px;
    height:           820px;
    transparency:     "real";
    location:         center;
    anchor:           center;
    border:           2px;
    border-color:     @mauve;
    border-radius:    14px;
    background-color: @base;
    padding:          0;
}

mainbox {
    children: [ inputbar, message, listview ];
    padding:  16px;
    spacing:  10px;
}

inputbar {
    background-color: @mantle;
    border:           1px;
    border-color:     @surface1;
    border-radius:    10px;
    padding:          9px 14px;
    spacing:          10px;
    children:         [ prompt, entry ];
}

prompt {
    text-color: @mauve;
    font:       "JetBrainsMono Nerd Font Bold 11";
}

entry {
    placeholder:       "Type to filter…";
    placeholder-color: @dim;
    cursor:            text;
}

message {
    background-color: @surface0;
    border-radius:    8px;
    padding:          8px 12px;
}

textbox {
    text-color: @subtext;
    font:       "JetBrainsMono Nerd Font 10";
}

listview {
    columns:      1;
    lines:        22;
    spacing:      1px;
    scrollbar:    true;
    cycle:        false;
    dynamic:      true;
    fixed-height: true;
}

scrollbar {
    width:            5px;
    handle-width:     5px;
    handle-color:     @surface2;
    border-radius:    4px;
    background-color: @mantle;
}

element {
    padding:       3px 10px;
    border-radius: 6px;
    cursor:        default;
}

element normal.normal    { text-color: @text; }
element alternate.normal { text-color: @text; }

element selected.normal {
    background-color: @surface0;
    text-color:       @text;
}

element-text {
    font:             "JetBrainsMono Nerd Font 10";
    vertical-align:   0.5;
    background-color: transparent;
    text-color:       inherit;
    /* `highlight` does not accept @variable references - literal only. */
    highlight:        bold #f9e2af;
}
