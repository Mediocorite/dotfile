# ═════════════════════════════════════════════════════════════════════════════
#  i3 config — Catppuccin Mocha
#
#  Conventions used by ~/.local/bin/i3-cheatsheet (Super + / shows the sheet):
#    # === Section ===   groups the bindings below it
#    ## text             describes the binding on the next line
#  Keep those in place when you add bindings and the cheatsheet stays accurate.
# ═════════════════════════════════════════════════════════════════════════════

set $mod Mod4
set $alt Mod1
set $term ghostty

# Catppuccin Mocha
set $base     #1e1e2e
set $mantle   #181825
set $crust    #11111b
set $surface0 #313244
set $surface1 #45475a
set $overlay0 #6c7086
set $text     #cdd6f4
set $subtext  #a6adc8
set $blue     #89b4fa
set $lavender #b4befe
set $green    #a6e3a1
set $yellow   #f9e2af
set $peach    #fab387
set $red      #f38ba8
set $mauve    #cba6f7

font pango:JetBrainsMono Nerd Font Bold 11

# ── look & feel ──────────────────────────────────────────────────────────────
# No titlebars: the polybar task list already shows what is open, with icons.
default_border          pixel 3
default_floating_border pixel 3
hide_edge_borders       smart
title_align             center

gaps inner 10
gaps outer 4
gaps top 4
smart_gaps on
smart_borders on

#                       border    background  text      indicator  child_border
client.focused          $blue     $blue       $crust    $lavender  $blue
client.focused_inactive $surface0 $surface0   $subtext  $surface0  $surface0
client.unfocused        $mantle   $mantle     $overlay0 $mantle    $mantle
client.urgent           $red      $red        $crust    $red       $red
client.placeholder      $base     $base       $text     $base      $base
client.background       $base

focus_follows_mouse no
mouse_warping none
focus_on_window_activation smart
popup_during_fullscreen smart
workspace_auto_back_and_forth yes

floating_modifier $mod
tiling_drag modifier titlebar

# ── autostart ────────────────────────────────────────────────────────────────
exec --no-startup-id dex --autostart --environment i3

# Secret Service for apps that store credentials (Claude Code, browsers, git).
# Cinnamon started this as part of its session; i3 does not, so without this
# line the keyring only appears if something happens to D-Bus-activate it --
# and anything launching before that races it and fails to save its login.
# PAM (/etc/pam.d/lightdm) unlocks the keyring at login; this just guarantees
# the daemon is up.
exec --no-startup-id /usr/bin/gnome-keyring-daemon --start --components=secrets,pkcs11,ssh

exec --no-startup-id nm-applet
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock -c 1e1e2e --nofork
exec --no-startup-id dunst

# AudioRelay. `exec` rather than `exec_always` so reloading the config does not
# start a second copy.
exec --no-startup-id /opt/audiorelay/bin/AudioRelay

# Wallpaper, compositor and bar are re-applied on every reload/restart.
# Guarded so a missing package never blocks the rest of the config.
exec_always --no-startup-id sh -c 'command -v feh >/dev/null && feh --no-fehbg --bg-fill ~/Pictures/wallpapers/catppuccin-mesh.png'
exec_always --no-startup-id sh -c 'command -v picom >/dev/null && (pkill -x picom; sleep 0.5; picom --config ~/.config/picom.conf -b)'
exec_always --no-startup-id sh -c 'command -v polybar >/dev/null && ~/.config/polybar/launch.sh'

# === Launching ===

## Open a terminal (Ghostty)
bindsym $mod+Return exec --no-startup-id $term

## Open a floating scratch terminal
bindsym $mod+Shift+Return exec --no-startup-id $term --class=ghostty-float

## Application launcher
bindsym $mod+d exec --no-startup-id rofi -show drun

## Run a command
bindsym $mod+Shift+d exec --no-startup-id rofi -show run

## Jump to an open window
bindsym $mod+Tab exec --no-startup-id rofi -show window

## Show this keybinding cheatsheet
bindsym $mod+slash exec --no-startup-id ~/.local/bin/i3-cheatsheet

## Power menu (lock / suspend / reboot / shut down)
bindsym $mod+Escape exec --no-startup-id ~/.local/bin/i3-powermenu

## Lock the screen
bindsym $mod+Shift+x exec --no-startup-id i3lock -c 1e1e2e

## File manager
bindsym $mod+n exec --no-startup-id nemo

## Web browser
bindsym $mod+b exec --no-startup-id firefox

# === Windows ===

## Close the focused window
bindsym $mod+q kill
bindsym $mod+Shift+q kill

## Focus left / down / up / right
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

## Move the window left / down / up / right
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

## Fullscreen
bindsym $mod+f fullscreen toggle

## Toggle floating
bindsym $mod+Shift+space floating toggle

## Switch focus between tiling and floating
bindsym $mod+space focus mode_toggle

## Focus the parent container
bindsym $mod+a focus parent

## Focus the child container
bindsym $mod+Shift+a focus child

## Sticky window (follows you across workspaces)
bindsym $mod+Shift+s sticky toggle

# === Layout ===

## Split the next window horizontally
bindsym $mod+backslash split h

## Split the next window vertically
bindsym $mod+minus split v

## Stacking layout
bindsym $mod+s layout stacking

## Tabbed layout
bindsym $mod+w layout tabbed

## Toggle split layout
bindsym $mod+e layout toggle split

## Enter resize mode
bindsym $mod+r mode "resize"

## Open Android Studio + Claude together on workspace 2 (2/3 + 1/3)
bindsym $mod+Shift+i exec --no-startup-id ~/.local/bin/i3-dev-layout

## Re-apply the 2/3 + 1/3 split on workspace 2
bindsym $mod+Shift+t exec --no-startup-id i3-msg '[class="^com\.anthropic\.Claude$"] resize set width 33 ppt'

# === Workspaces ===

set $ws1  "1"
set $ws2  "2"
set $ws3  "3"
set $ws4  "4"
set $ws5  "5"
set $ws6  "6"
set $ws7  "7"
set $ws8  "8"
set $ws9  "9"
set $ws10 "10"

## Switch to workspace 1-10
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

## Move the window to workspace 1-10
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

## Next / previous workspace
bindsym $mod+period workspace next_on_output
bindsym $mod+comma workspace prev_on_output

## Back to the last workspace
bindsym $mod+grave workspace back_and_forth

# === Media & hardware ===

## Volume up / down / mute
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle

## Mute the microphone
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle

## Play / pause, next, previous track
bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext exec --no-startup-id playerctl next
bindsym XF86AudioPrev exec --no-startup-id playerctl previous

## Screen brightness up / down
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set +5%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 5%-

## Screenshot the whole screen
bindsym Print exec --no-startup-id sh -c 'maim ~/Pictures/screenshot-$(date +%F-%H%M%S).png'

## Screenshot a region to the clipboard
bindsym Shift+Print exec --no-startup-id sh -c 'maim -s | xclip -selection clipboard -t image/png'

# === i3 session ===

## Reload the config file
bindsym $mod+Shift+c reload

## Restart i3 in place
bindsym $mod+Shift+r restart

## Exit i3
bindsym $mod+Shift+e exec --no-startup-id "i3-nagbar -t warning -m 'Exit i3 and end this X session?' -B 'Yes, exit i3' 'i3-msg exit'"

# ── resize mode ──────────────────────────────────────────────────────────────
mode "resize" {
        bindsym h resize shrink width 5 px or 5 ppt
        bindsym j resize grow height 5 px or 5 ppt
        bindsym k resize shrink height 5 px or 5 ppt
        bindsym l resize grow width 5 px or 5 ppt

        bindsym Left resize shrink width 5 px or 5 ppt
        bindsym Down resize grow height 5 px or 5 ppt
        bindsym Up resize shrink height 5 px or 5 ppt
        bindsym Right resize grow width 5 px or 5 ppt

        ## Snap the focused window to 1/3, 1/2 or 2/3 width
        bindsym 1 resize set width 33 ppt
        bindsym 2 resize set width 50 ppt
        bindsym 3 resize set width 66 ppt

        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}

# ═════════════════════════════════════════════════════════════════════════════
#  Window rules
# ═════════════════════════════════════════════════════════════════════════════

# ── workspace assignments ────────────────────────────────────────────────────
# Class names are matched case-insensitively so a rule survives an app
# changing its WM_CLASS capitalisation between releases.
# Real WM_CLASS values, taken from each app's StartupWMClass:
#   Android Studio          -> jetbrains-studio
#   Claude desktop app      -> com.anthropic.Claude
# (Dots are regex metacharacters here, so they are escaped.)
assign [class="(?i)^(firefox|firefox-esr|zen|librewolf)$"] number 1
assign [class="(?i)(android-studio|jetbrains-studio)"] number 2
assign [class="^com\.anthropic\.Claude$"] number 2

# ── the 2/3 + 1/3 IDE layout on workspace 2 ──────────────────────────────────
# Workspace 2 tiles horizontally, so the two land side by side. Claude sizes
# itself to 33% as it opens, which pushes Android Studio to the remaining 67%
# -- one rule, rather than two that fight over the same split.
# Super+Shift+I opens the pair together with the order fixed in advance; see
# ~/.config/i3/layouts/ws2-dev.json.
for_window [class="(?i)(android-studio|jetbrains-studio)"] layout splith
for_window [class="^com\.anthropic\.Claude$"] resize set width 33 ppt

# Android Studio's splash and popup windows should float, not tile.
for_window [class="(?i)jetbrains" window_type="dialog"] floating enable
for_window [class="(?i)jetbrains" title="^win0$"] floating enable, border none
for_window [class="(?i)jetbrains" title="(?i)^(splash|welcome)"] floating enable

# ── floating windows ─────────────────────────────────────────────────────────
for_window [class="ghostty-float"] floating enable, resize set 1000 620, move position center
for_window [window_role="pop-up"] floating enable
for_window [window_role="task_dialog"] floating enable
for_window [window_type="dialog"] floating enable
for_window [window_type="menu"] floating enable
for_window [class="(?i)(pavucontrol|blueman-manager|nm-connection-editor)"] floating enable, resize set 900 600, move position center
for_window [class="(?i)(gnome-calculator|galculator)"] floating enable
for_window [title="(?i)^(file operation progress|copying|moving)"] floating enable
for_window [class="(?i)^(xfce4-appfinder|gpick)$"] floating enable

# Picture-in-picture always on top.
for_window [title="(?i)picture[- ]in[- ]picture"] floating enable, sticky enable, border none

