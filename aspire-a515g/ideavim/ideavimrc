" ═══════════════════════════════════════════════════════════════════════════
"  IdeaVim - VSCodeVim + VSpaceCode equivalent for Android Studio
"
"  Two layers, same as the VS Code setup:
"    * this file        -> everything Vim owns (motions, leader menus)
"    * keymaps/VSCode-Vim.xml -> everything the IDE owns (Ctrl+E, Ctrl+T, ...)
"
"  Which-Key renders the leader menus, standing in for VSpaceCode.
"  Reload after editing with  :source ~/.ideavimrc
" ═══════════════════════════════════════════════════════════════════════════

" ── plugins ────────────────────────────────────────────────────────────────
set which-key                 " VSpaceCode-style popup menus
set easymotion                " needs the IdeaVim-EasyMotion + AceJump plugins
set surround                  " cs"' , ds" , ys
set commentary                " gcc , gc<motion>
set multiple-cursors
set ReplaceWithRegister       " gr<motion>
set argtextobj                " aa / ia
set textobj-entire            " ae / ie
set highlightedyank
set exchange                  " cx
set matchit

" ── general behaviour ──────────────────────────────────────────────────────
set scrolloff=6
set sidescrolloff=6
set incsearch
set hlsearch
set ignorecase
set smartcase
set number
set relativenumber
set showmode
set showcmd
set visualbell
set clipboard+=unnamedplus
set clipboard+=ideaput
set ideajoin                  " use the IDE's smart join for J
set idearefactormode=keep

" Which-Key needs a long timeout, otherwise a pending menu closes itself.
set timeoutlen=5000

let mapleader = " "

" ── Which-Key appearance (Catppuccin Mocha, matching the desktop) ──────────
let g:WhichKey_FontSize             = 14
let g:WhichKey_CommandColor         = "#89b4fa"
let g:WhichKey_PrefixColor          = "#cba6f7"
let g:WhichKey_KeyColor             = "#f9e2af"
let g:WhichKey_SortOrder            = "by_key_prefix_first"
let g:WhichKey_ShowTypedSequence    = "true"
let g:WhichKey_DefaultDelay         = 200
let g:WhichKey_ShowVimActions       = "true"

" ═══════════════════════════════════════════════════════════════════════════
"  Ctrl-key ownership
"
"  sethandler decides, per mode, whether IdeaVim or the IDE gets a chord.
"  This is what lets Ctrl+J mean "focus the split below" in normal mode and
"  "next completion item" while typing -- the same split the VS Code config
"  achieved with `when` clauses.
" ═══════════════════════════════════════════════════════════════════════════
sethandler <C-H> n-v:vim i:ide
sethandler <C-J> n-v:vim i:ide
sethandler <C-K> n-v:vim i:ide
sethandler <C-L> n-v:vim i:ide
sethandler <C-N> n-v:vim i:ide
" These belong to the IDE everywhere, exactly as in the VS Code keymap.
sethandler <C-B> a:ide
sethandler <C-D> a:ide
sethandler <C-E> a:ide
sethandler <C-G> a:ide
sethandler <C-T> a:ide
sethandler <C-M> a:ide
sethandler <C-I> a:ide
sethandler <C-S> a:ide

" ── split navigation (VS Code: workbench.action.navigateLeft/Right/Up/Down)
nnoremap <C-h> <C-w>h
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
nnoremap <C-l> <C-w>l

" ── editor tabs (VS Code: previousEditor / nextEditor in Normal mode) ──────
nnoremap H :action PreviousTab<CR>
nnoremap L :action NextTab<CR>

" ── hover in Normal, move lines in Visual (VS Code: shift+k / shift+j) ─────
nnoremap K :action ShowHoverInfo<CR>
" MoveLineDown/Up are the exact counterparts of VS Code's
" editor.action.moveLinesDownAction/UpAction. Vim's `:m ... | gv=gv` idiom is
" avoided here because IdeaVim's `=` reindent operator is unreliable.
vnoremap J :action MoveLineDown<CR>
vnoremap K :action MoveLineUp<CR>

" ── multi-cursor (VS Code: ctrl+n addSelectionToNextFindMatch) ─────────────
nnoremap <C-n> :action SelectNextOccurrence<CR>
xnoremap <C-n> :action SelectNextOccurrence<CR>

" ── small quality-of-life ──────────────────────────────────────────────────
nnoremap <Esc> :nohlsearch<CR>
nnoremap Y y$
" keep the cursor put when joining and when jumping through search hits
nnoremap n nzzzv
nnoremap N Nzzzv
" indent without losing the selection
vnoremap < <gv
vnoremap > >gv

